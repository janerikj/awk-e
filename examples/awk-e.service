[Unit]
Description=awk-e MQTT event router
Documentation=file:/usr/local/share/doc/awk-e/README.md
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
# --mqtt is the subscription: inputs are opt-in, so a unit that wants broker
# traffic has to ask for it (AWKE_MQTT=1 in the .env works too).
ExecStart=/usr/local/bin/awk-e -q --mqtt -e /etc/awk-e/.env -r /etc/awk-e/rules
Restart=always
RestartSec=5

# the router needs nothing but a network socket
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/awk-e
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target